{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        ".read": "auth != null",
        "meta": {
          ".write": "auth != null && (!data.exists() || data.child('createdBy').val() === auth.uid)",
          ".validate": "newData.hasChildren(['createdBy','createdAt'])"
        },
        "members": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChild('name') && newData.child('name').isString() && newData.child('name').val().length <= 40"
          }
        }
      }
    }
  }
}
